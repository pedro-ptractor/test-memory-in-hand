// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  phone     String
  cpf       String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses     Address[]
  photoPacks    PhotoPack[]
  subscriptions Subscription[]
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  recipient  String
  zipCode    String
  street     String
  number     String
  complement String?
  district   String
  city       String
  state      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Plan {
  id            String         @id @default(uuid())
  name          String
  photoLimit    Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
  planPrices    PlanPrice[]
}

model PlanPrice {
  id        String       @id @default(uuid())
  planId    String
  plan      Plan         @relation(fields: [planId], references: [id])
  price     Decimal // valor do ciclo
  cycle     BillingCycle
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Subscription {
  id           String             @id @default(uuid())
  status       SubscriptionStatus @default(PENDING)
  startDate    DateTime?
  endDate      DateTime?
  userId       String
  billingCycle BillingCycle       @default(MONTHLY)
  user         User               @relation(fields: [userId], references: [id])
  planId       String
  plan         Plan               @relation(fields: [planId], references: [id])
  payments     Payment[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model Payment {
  id               String        @id @default(uuid())
  gatewayPaymentId String
  amountInCents    Int
  status           PaymentStatus @default(PENDING) // PENDING, PAID, EXPIRED
  pixCode          String?
  pixQrCodeBase64  String?
  expiresAt        DateTime?
  paidAt           DateTime?
  subscriptionId   String
  subscription     Subscription  @relation(fields: [subscriptionId], references: [id])
  createdAt        DateTime      @default(now())
}

model MonthlyCycle {
  id         String      @id @default(uuid())
  year       Int
  month      Int
  photoPacks PhotoPack[]
  createdAt  DateTime    @default(now())
}

model PhotoPack {
  id             String       @id @default(uuid())
  status         PackStatus   @default(PENDING)
  trackingCode   String?
  shippingDate   DateTime?
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  monthlyCycleId String
  monthlyCycle   MonthlyCycle @relation(fields: [monthlyCycleId], references: [id])
  photos         Photo[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Photo {
  id          String    @id @default(uuid())
  url         String
  photoPackId String
  photoPack   PhotoPack @relation(fields: [photoPackId], references: [id])
  createdAt   DateTime  @default(now())
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum PackStatus {
  PENDING
  SENT_TO_LAB
  PRINTED
  SHIPPED
  DELIVERED
}

enum Role {
  USER
  ADMIN
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELED
  EXPIRED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  CANCELED
  EXPIRED
}
